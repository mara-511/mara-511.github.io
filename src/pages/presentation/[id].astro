---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
    title="Video de presentación" 
    description="Conoce más sobre mí en este video"
    pageType="article"
    showHeader={false}
>
    <article class="mb-16 sm:mb-24">
        <header class="mb-8">
            <h1 class="font-serif text-3xl leading-tight font-medium sm:text-5xl">
                Video de presentación
            </h1>
        </header>

        <div class="aspect-video w-full max-w-4xl mx-auto">
            <iframe 
                class="w-full h-full rounded-xl"
                src="https://www.youtube.com/watch?v=wxp3xSkbVRU"
                title="Video de presentación"
                frameborder="0"
                allowfullscreen>
            </iframe>
        </div>
    </article>
</BaseLayout>
