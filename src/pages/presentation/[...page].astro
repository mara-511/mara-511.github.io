---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
    title="Video de presentación" 
    description="Mira mi video de presentación"
    showHeader={false}
>
    <h1 class="mb-12 font-serif text-2xl leading-tight italic sm:mb-16 sm:text-4xl">
        Video de presentación
    </h1>

    <div class="aspect-video w-full max-w-4xl mx-auto">
        <!-- OPCIÓN YOUTUBE -->
        <iframe 
            class="w-full h-full rounded-xl"
            src="https://www.youtube.com/watch?v=wxp3xSkbVRU"
            title="Video de presentación"
            frameborder="0"
            allowfullscreen>
        </iframe>

        <!-- OPCIÓN VIDEO LOCAL (usa esta si el video está en /public) -->
        <!--
        <video controls class="w-full rounded-xl">
            <source src="/video-presentacion.mp4" type="video/mp4" />
            Tu navegador no soporta video HTML5.
        </video>
        -->
    </div>
</BaseLayout>
